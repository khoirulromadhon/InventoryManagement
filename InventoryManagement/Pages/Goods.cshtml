@page
@model InventoryManagement.Pages.GoodsModel
@{
    ViewData["Title"] = "Goods";
}

<div class="container mt-4">
    <h2>Goods</h2>

    <div class="row mb-3">
        <div class="col-md-8 d-flex">
            <input id="goodsSearch" class="form-control me-2" placeholder="Search goods..." />
            <button id="searchGoods" class="btn btn-primary">Search</button>
        </div>
        <div class="col-md-4 text-end">
            <button id="refreshGoods" class="btn btn-secondary">Refresh</button>
        </div>
    </div>

    <div id="goodsMsg"></div>
    <div id="goodsTable"></div>
</div>

@section Scripts {
    <script src="~/js/goods.js"></script>
}
